{
  "name": "mottainai",
  "version": "0.9.3",
  "description": "Coding-agent orchestration and MCP context runtime with governed repository execution, bounded tool results, and multi-agent session management.",
  "type": "module",
  "bin": {
    "mottainai": "dist/index.js",
    "mtnai": "dist/index.js",
    "mottainai-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mottainai.config.json.example",
    ".github/inari/pull-requests/default.json",
    ".github/inari/issues/*.json",
    "scripts/governance-lib.mjs",
    "scripts/governance-rules.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false && node scripts/generate-build-metadata.mjs && node scripts/copy-dashboard-assets.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/run-test-suite.mjs fast",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "test:e2e": "node scripts/run-test-suite.mjs e2e",
    "test:all": "pnpm run test && pnpm run test:integration && pnpm run test:e2e",
    "test:classification": "node scripts/test-suites.mjs && node --test scripts/test-suites.test.mjs",
    "test:ci-ownership": "node --test scripts/ci-contract-ownership.test.mjs",
    "test:ci-runtime-gates": "node --test scripts/ci-runtime-contract-gates.test.mjs",
    "test:standards": "pnpm run architecture:test && pnpm run governance:test && pnpm run governance:actions && pnpm run governance:oras && pnpm run test:actions && pnpm run test:classification && pnpm run test:ci-ownership && pnpm run test:ci-runtime-gates && pnpm run test:coverage:policy && pnpm run test:inari && pnpm run governance:inari",
    "test:coverage:policy": "node --test scripts/coverage.test.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "test:property": "node --import tsx scripts/property-tests.mjs",
    "test:mutation": "node scripts/mutation-test.mjs",
    "test:effectiveness": "pnpm run test:property && pnpm run test:mutation",
    "test:package": "pnpm run build && node scripts/run-package-suite.mjs",
    "verify": "pnpm run verify:standards && pnpm run typecheck && pnpm test && pnpm run test:integration && pnpm run build && pnpm run test:e2e && pnpm run test:coverage && pnpm run test:package",
    "mcp": "tsx scripts/mcp.ts",
    "policy": "tsx scripts/policy.ts",
    "read-governor": "tsx scripts/read-governor.ts",
    "governance:pr": "node scripts/validate-pr.mjs",
    "governance:pr:local": "node scripts/governance-check-local.mjs",
    "governance:actions": "node scripts/validate-actions.mjs",
    "governance:oras": "node scripts/validate-oras-compatibility.mjs",
    "governance:inari": "node scripts/validate-inari-templates.mjs",
    "governance:issue:local": "node scripts/governance-check-issue-local.mjs",
    "governance:issue": "node scripts/validate-issue.mjs",
    "governance:branch": "node scripts/validate-branch-name.mjs",
    "semantic:validate": "tsx scripts/semantic-governance.ts",
    "semantic:dogfood": "node --import tsx --test src/semantics/enforcement.test.ts",
    "governance:test": "node --test scripts/governance.test.mjs",
    "test:actions": "node --test scripts/validate-actions.test.mjs scripts/npm-publish-contract.test.mjs scripts/publish-release-lookup.test.mjs scripts/deployment-artifact-roundtrip-gate.test.mjs scripts/validate-oras-compatibility.test.mjs",
    "test:inari": "node --test scripts/validate-inari-templates.test.mjs",
    "format": "prettier --write 'scripts/architecture-check.mjs' 'scripts/architecture-check.test.mjs' 'scripts/ci-contract-ownership.mjs' 'scripts/ci-contract-ownership.test.mjs' 'scripts/ci-runtime-contract-gates.mjs' 'scripts/ci-runtime-contract-gates.test.mjs' 'scripts/coverage.mjs' 'scripts/coverage.test.mjs' 'scripts/copy-dashboard-assets.mjs' 'scripts/create-release-managed-generation.mjs' 'scripts/deployment-artifact-roundtrip-gate.test.mjs' 'scripts/generate-build-metadata.mjs' 'scripts/gh-inari-package-smoke.mjs' 'scripts/gh-makami-package-smoke.mjs' 'scripts/lima-validation-probe.mjs' 'scripts/lima-validation-probe.test.mjs' 'scripts/mutation-catalog.mjs' 'scripts/mutation-test.mjs' 'scripts/npm-publish-contract.test.mjs' 'scripts/publish-release-lookup.test.mjs' 'scripts/property-tests.mjs' 'scripts/release-managed-generation.test.mjs' 'scripts/route2-runtime-smoke.mjs' 'scripts/run-test-suite.mjs' 'scripts/test-suites.mjs' 'scripts/test-suites.test.mjs' 'scripts/validate-actions.mjs' 'scripts/validate-actions.test.mjs' 'scripts/validate-oras-compatibility.mjs' 'scripts/validate-oras-compatibility.test.mjs' 'scripts/validate-inari-templates.mjs' 'scripts/validate-inari-templates.test.mjs' 'scripts/verify-deployment-artifact-roundtrip.mjs' 'scripts/coverage-policy.json' 'eslint.config.mjs' 'prettier.config.mjs' 'package.json'",
    "format:check": "prettier --check 'scripts/architecture-check.mjs' 'scripts/architecture-check.test.mjs' 'scripts/ci-contract-ownership.mjs' 'scripts/ci-contract-ownership.test.mjs' 'scripts/ci-runtime-contract-gates.mjs' 'scripts/ci-runtime-contract-gates.test.mjs' 'scripts/coverage.mjs' 'scripts/coverage.test.mjs' 'scripts/copy-dashboard-assets.mjs' 'scripts/create-release-managed-generation.mjs' 'scripts/deployment-artifact-roundtrip-gate.test.mjs' 'scripts/generate-build-metadata.mjs' 'scripts/gh-inari-package-smoke.mjs' 'scripts/gh-makami-package-smoke.mjs' 'scripts/lima-validation-probe.mjs' 'scripts/lima-validation-probe.test.mjs' 'scripts/mutation-catalog.mjs' 'scripts/mutation-test.mjs' 'scripts/npm-publish-contract.test.mjs' 'scripts/publish-release-lookup.test.mjs' 'scripts/property-tests.mjs' 'scripts/release-managed-generation.test.mjs' 'scripts/route2-runtime-smoke.mjs' 'scripts/run-test-suite.mjs' 'scripts/test-suites.mjs' 'scripts/test-suites.test.mjs' 'scripts/validate-actions.mjs' 'scripts/validate-actions.test.mjs' 'scripts/validate-oras-compatibility.mjs' 'scripts/validate-oras-compatibility.test.mjs' 'scripts/validate-inari-templates.mjs' 'scripts/validate-inari-templates.test.mjs' 'scripts/verify-deployment-artifact-roundtrip.mjs' 'scripts/coverage-policy.json' 'eslint.config.mjs' 'prettier.config.mjs' 'package.json'",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.mjs' 'scripts/**/*.mjs' 'eslint.config.mjs'",
    "architecture:test": "node --test scripts/architecture-check.test.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "verify:standards": "pnpm run format:check && pnpm run lint && pnpm run test:standards && pnpm run architecture:check",
    "typecheck": "tsc --noEmit",
    "smoke-test": "node scripts/smoke-test.mjs",
    "benchmark:semantic-cache": "node --import tsx scripts/benchmark-semantic-fact-cache.mjs",
    "benchmark:validation-governor": "node --import tsx scripts/benchmark-validation-governor.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.8.3",
    "ws": "^8.21.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "1.11.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "9.29.0",
    "nawabari": "^0.6.1",
    "prettier": "3.6.2",
    "suzukuri": "^0.1.0",
    "tsx": "^4.19.4",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohn-jp/mottainai.git"
  },
  "homepage": "https://github.com/yohn-jp/mottainai#readme",
  "bugs": {
    "url": "https://github.com/yohn-jp/mottainai/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "llm",
    "agent",
    "gateway",
    "proxy",
    "tool-compression"
  ]
}
