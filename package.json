{
  "name": "mottainai",
  "version": "0.1.3",
  "description": "MCP proxy gateway: aggregates upstream MCP servers behind one endpoint and compresses their tool definitions and results before they reach the LLM.",
  "type": "module",
  "bin": {
    "mottainai": "dist/index.js",
    "mtnai": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mottainai.config.json.example",
    "scripts/governance-lib.mjs",
    "scripts/governance-rules.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-build-metadata.mjs && node scripts/copy-dashboard-assets.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/run-test-suite.mjs fast",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "test:e2e": "node scripts/run-test-suite.mjs e2e",
    "test:all": "pnpm run test && pnpm run test:integration && pnpm run test:e2e",
    "test:classification": "node scripts/test-suites.mjs && node --test scripts/test-suites.test.mjs",
    "test:standards": "pnpm run architecture:test && pnpm run governance:test && pnpm run test:classification && pnpm run test:coverage:policy",
    "test:coverage:policy": "node --test scripts/coverage.test.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "test:property": "node --import tsx scripts/property-tests.mjs",
    "test:mutation": "node scripts/mutation-test.mjs",
    "test:effectiveness": "pnpm run test:property && pnpm run test:mutation",
    "test:package": "pnpm run build && node scripts/run-package-suite.mjs",
    "verify": "pnpm run verify:standards && pnpm run typecheck && pnpm test && pnpm run test:integration && pnpm run test:e2e && pnpm run test:coverage && pnpm run test:package",
    "mcp": "tsx scripts/mcp.ts",
    "policy": "tsx scripts/policy.ts",
    "read-governor": "tsx scripts/read-governor.ts",
    "governance:pr": "node scripts/validate-pr.mjs",
    "governance:pr:local": "node scripts/governance-check-local.mjs",
    "governance:issue:local": "node scripts/governance-check-issue-local.mjs",
    "governance:issue": "node scripts/validate-issue.mjs",
    "governance:branch": "node scripts/validate-branch-name.mjs",
    "governance:test": "node --test scripts/governance.test.mjs",
    "format": "prettier --write 'scripts/architecture-check.mjs' 'scripts/architecture-check.test.mjs' 'scripts/coverage.mjs' 'scripts/coverage.test.mjs' 'scripts/copy-dashboard-assets.mjs' 'scripts/generate-build-metadata.mjs' 'scripts/mutation-catalog.mjs' 'scripts/mutation-test.mjs' 'scripts/property-tests.mjs' 'scripts/run-test-suite.mjs' 'scripts/test-suites.mjs' 'scripts/test-suites.test.mjs' 'scripts/coverage-policy.json' 'eslint.config.mjs' 'prettier.config.mjs' 'package.json'",
    "format:check": "prettier --check 'scripts/architecture-check.mjs' 'scripts/architecture-check.test.mjs' 'scripts/coverage.mjs' 'scripts/coverage.test.mjs' 'scripts/copy-dashboard-assets.mjs' 'scripts/generate-build-metadata.mjs' 'scripts/mutation-catalog.mjs' 'scripts/mutation-test.mjs' 'scripts/property-tests.mjs' 'scripts/run-test-suite.mjs' 'scripts/test-suites.mjs' 'scripts/test-suites.test.mjs' 'scripts/coverage-policy.json' 'eslint.config.mjs' 'prettier.config.mjs' 'package.json'",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.mjs' 'scripts/**/*.mjs' 'eslint.config.mjs'",
    "architecture:test": "node --test scripts/architecture-check.test.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "verify:standards": "pnpm run format:check && pnpm run lint && pnpm run test:standards && pnpm run architecture:check",
    "typecheck": "tsc --noEmit",
    "smoke-test": "node scripts/smoke-test.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "tsx": "^4.19.4",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohn-jp/mottainai.git"
  },
  "homepage": "https://github.com/yohn-jp/mottainai#readme",
  "bugs": {
    "url": "https://github.com/yohn-jp/mottainai/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "llm",
    "agent",
    "gateway",
    "proxy",
    "tool-compression"
  ]
}
