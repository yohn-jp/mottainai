{
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run build)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/warn-grep.sh"
          }
        ]
      }
    ]
  }
}
