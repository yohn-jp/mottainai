{
  "version": 2,
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp", "--path", "."]
    },
    "fff": {
      "command": "fff-mcp",
      "args": ["."]
    },
    "github": {
      "transport": "streamableHttp",
      "url": "https://api.githubcopilot.com/mcp/",
      "capabilities": ["github"],
      "enabled": false
    }
  },
  "gateway": {
    "responseBudget": {
      "softTokens": 1500,
      "hardTokens": 3000,
      "hardBytes": 12000
    },
    "readGovernor": {
      "mode": "observe",
      "maxRawLines": 400,
      "maxRawBytes": 16384,
      "allowWholeFileBelowLines": 120,
      "preferAuto": true,
      "allowWholeFile": false
    },
    "ghInari": {
      "command": "gh-inari",
      "timeoutMs": 30000,
      "maxOutputBytes": 1048576,
      "maxInputBytes": 1048576
    }
  }
}
