{
  "version": 2,
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp", "--path", "."]
    },
    "fff": {
      "command": "fff-mcp",
      "args": ["."]
    },
    "github": {
      "transport": "streamableHttp",
      "url": "https://api.githubcopilot.com/mcp/",
      "capabilities": ["github"],
      "enabled": false
    }
  },
  "gateway": {
    "responseBudget": {
      "softTokens": 1500,
      "hardTokens": 3000,
      "hardBytes": 12000
    },
    "readGovernor": {
      "mode": "enforce",
      "maxRawLines": 120,
      "maxRawBytes": 12000,
      "allowWholeFileBelowLines": 120,
      "preferAuto": true
    }
  }
}
