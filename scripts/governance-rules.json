{
  "pullRequest": {
    "titlePattern": "^(feat|fix|docs|refactor|test|chore)\\((cli|proxy|config|compression|routing|upstream|security|release|docs|ci)\\): [a-z0-9].{4,}$",
    "branchPattern": "^(feat|fix|docs|refactor|test|chore)/[0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*$",
    "minimumBodyLength": 300,
    "requiredSections": [
      "Summary",
      "Linked issue",
      "Scope",
      "Included",
      "Excluded",
      "Implementation",
      "Behavioral changes",
      "Validation",
      "Risks",
      "Breaking changes",
      "Review focus"
    ],
    "validationItems": ["Typecheck", "Tests", "Build"],
    "packageCheckPaths": [
      "^package\\.json$",
      "^pnpm-lock\\.yaml$",
      "^tsconfig\\.build\\.json$",
      "^src/index\\.ts$",
      "^src/server\\.ts$",
      "^src/cli\\.ts$",
      "^\\.github/workflows/publish\\.yml$"
    ],
    "changedFileRules": {
      "configurationPaths": ["^src/config\\.ts$", "^mottainai\\.config(?:\\..+)?$"],
      "compressionPaths": ["^src/compress/"],
      "compressionTestPaths": ["^src/compress/.*\\.test\\.ts$"],
      "cliPaths": ["^src/index\\.ts$", "^src/cli\\.ts$", "^scripts/mcp\\.ts$"],
      "cliEvidencePaths": ["^README\\.md$", "(?:^|/)cli.*\\.test\\.ts$", "(?:^|/)index.*\\.test\\.ts$"],
      "securityPaths": ["security", "auth", "sandbox", "local-tools"]
    }
  },
  "issue": {
    "requiredSections": [
      "Summary",
      "Problem",
      "Goal",
      "Non-goals",
      "Acceptance criteria",
      "Affected areas",
      "Risks / compatibility",
      "Dependencies",
      "Implementation notes"
    ],
    "minimumBodyLength": 200
  }
}
